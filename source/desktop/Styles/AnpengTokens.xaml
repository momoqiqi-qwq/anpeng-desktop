<?xml version="1.0" encoding="utf-8"?>
<!--
  安棚 · 设计令牌（唯一色值来源，照抄 APP-SPEC 第 3 节，禁止在页面里散落硬编码）
  品牌色（Brand*/Level*）在明暗主题下取值相同；中性色（墨黑/灰/线/底/卡）分两套。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ═══════════════ 浅色 ═══════════════ -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandBlueColor">#FF14538C</Color>
            <Color x:Key="BrandBlueTextColor">#FF0E3E68</Color>
            <Color x:Key="BrandBlueSoftColor">#FFE8EFF6</Color>
            <Color x:Key="BrandFireColor">#FFEE5A2E</Color>
            <Color x:Key="BrandDropColor">#FF2F8FD0</Color>
            <Color x:Key="DropLightColor">#FF6FCBEE</Color>
            <Color x:Key="InkColor">#FF1A1A1A</Color>
            <Color x:Key="MutedColor">#FF5F5E5A</Color>
            <Color x:Key="LineColor">#FFDBE1E8</Color>
            <Color x:Key="BgAltColor">#FFF4F6F8</Color>
            <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="LevelNormalColor">#FF2E9E5B</Color>
            <Color x:Key="LevelNoticeColor">#FFC79A00</Color>
            <Color x:Key="LevelSuspectColor">#FFE8760F</Color>
            <Color x:Key="LevelAlarmColor">#FFD93025</Color>
            <Color x:Key="LevelOfflineColor">#FF8A8A8A</Color>
        </ResourceDictionary>

        <!-- ═══════════════ 深色 ═══════════════ -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BrandBlueColor">#FF14538C</Color>
            <Color x:Key="BrandBlueTextColor">#FF9CC6EA</Color>
            <Color x:Key="BrandBlueSoftColor">#FF16304A</Color>
            <Color x:Key="BrandFireColor">#FFEE5A2E</Color>
            <Color x:Key="BrandDropColor">#FF2F8FD0</Color>
            <Color x:Key="DropLightColor">#FF6FCBEE</Color>
            <Color x:Key="InkColor">#FFF2F4F6</Color>
            <Color x:Key="MutedColor">#FFB4B2AC</Color>
            <Color x:Key="LineColor">#FF3A4048</Color>
            <Color x:Key="BgAltColor">#FF1B1F24</Color>
            <Color x:Key="SurfaceColor">#FF24282E</Color>
            <Color x:Key="LevelNormalColor">#FF2E9E5B</Color>
            <Color x:Key="LevelNoticeColor">#FFC79A00</Color>
            <Color x:Key="LevelSuspectColor">#FFE8760F</Color>
            <Color x:Key="LevelAlarmColor">#FFD93025</Color>
            <Color x:Key="LevelOfflineColor">#FF8A8A8A</Color>
        </ResourceDictionary>

        <!-- ═══════════════ 高对比 ═══════════════ -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="BrandBlueColor">#FF14538C</Color>
            <Color x:Key="BrandBlueTextColor">#FFFFFFFF</Color>
            <Color x:Key="BrandBlueSoftColor">#FF000000</Color>
            <Color x:Key="BrandFireColor">#FFEE5A2E</Color>
            <Color x:Key="BrandDropColor">#FF2F8FD0</Color>
            <Color x:Key="DropLightColor">#FF6FCBEE</Color>
            <Color x:Key="InkColor">#FFFFFFFF</Color>
            <Color x:Key="MutedColor">#FFFFFFFF</Color>
            <Color x:Key="LineColor">#FFFFFFFF</Color>
            <Color x:Key="BgAltColor">#FF000000</Color>
            <Color x:Key="SurfaceColor">#FF000000</Color>
            <Color x:Key="LevelNormalColor">#FF2E9E5B</Color>
            <Color x:Key="LevelNoticeColor">#FFC79A00</Color>
            <Color x:Key="LevelSuspectColor">#FFE8760F</Color>
            <Color x:Key="LevelAlarmColor">#FFD93025</Color>
            <Color x:Key="LevelOfflineColor">#FF8A8A8A</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 令牌 → 画刷（页面一律用这些键） -->
    <SolidColorBrush x:Key="BrandBlueBrush" Color="{ThemeResource BrandBlueColor}" />
    <SolidColorBrush x:Key="BrandBlueTextBrush" Color="{ThemeResource BrandBlueTextColor}" />
    <SolidColorBrush x:Key="BrandBlueSoftBrush" Color="{ThemeResource BrandBlueSoftColor}" />
    <SolidColorBrush x:Key="BrandFireBrush" Color="{ThemeResource BrandFireColor}" />
    <SolidColorBrush x:Key="BrandDropBrush" Color="{ThemeResource BrandDropColor}" />
    <SolidColorBrush x:Key="DropLightBrush" Color="{ThemeResource DropLightColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource MutedColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource LineColor}" />
    <SolidColorBrush x:Key="BgAltBrush" Color="{ThemeResource BgAltColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />

    <SolidColorBrush x:Key="LevelNormalBrush" Color="{ThemeResource LevelNormalColor}" />
    <SolidColorBrush x:Key="LevelNoticeBrush" Color="{ThemeResource LevelNoticeColor}" />
    <SolidColorBrush x:Key="LevelSuspectBrush" Color="{ThemeResource LevelSuspectColor}" />
    <SolidColorBrush x:Key="LevelAlarmBrush" Color="{ThemeResource LevelAlarmColor}" />
    <SolidColorBrush x:Key="LevelOfflineBrush" Color="{ThemeResource LevelOfflineColor}" />

    <!-- 级别 → 半透明浅底（表格行/信息条背景），仅用于铺底不用于文字 -->
    <SolidColorBrush x:Key="LevelNormalSoftBrush" Color="{ThemeResource LevelNormalColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="LevelNoticeSoftBrush" Color="{ThemeResource LevelNoticeColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="LevelSuspectSoftBrush" Color="{ThemeResource LevelSuspectColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="LevelAlarmSoftBrush" Color="{ThemeResource LevelAlarmColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="LevelOfflineSoftBrush" Color="{ThemeResource LevelOfflineColor}" Opacity="0.14" />

</ResourceDictionary>
