<?xml version="1.0" encoding="utf-8"?>
<!-- 安棚 · 通用样式：8px 网格、圆角 4/8/12、字号阶梯（APP-SPEC 3.3） -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面根：页底 #F4F6F8 -->
    <Style x:Key="AnpengPageRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgAltBrush}" />
        <Setter Property="Padding" Value="24,20,24,24" />
    </Style>

    <!-- 卡片：圆角 8、卡片白、1px 分割线描边（不用重阴影，避免“double-card”） -->
    <Style x:Key="AnpengCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="AnpengInnerCardStyle" TargetType="Border" BasedOn="{StaticResource AnpengCardStyle}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="AnpengSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="AnpengPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandBlueTextBrush}" />
    </Style>

    <Style x:Key="AnpengBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AnpengCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="AnpengStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- 主读数（大字） -->
    <Style x:Key="AnpengReadoutStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrandBlueTextBrush}" />
    </Style>

    <!-- 药丸标签（圆角 12） -->
    <Style x:Key="AnpengPillTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="AnpengTableHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AnpengTableCellStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="AnpengPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="AnpengDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandFireBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,6" />
    </Style>

    <Style x:Key="AnpengPlainButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

</ResourceDictionary>
