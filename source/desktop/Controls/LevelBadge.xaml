<?xml version="1.0" encoding="utf-8"?>
<!-- 级别徽章（药丸形，圆角 12）。颜色一律取令牌表，禁止硬编码 hex。 -->
<UserControl
    x:Class="Anpeng.Desktop.Controls.LevelBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <Border x:Name="Host" CornerRadius="12" Padding="10,3,10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock x:Name="Label" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI" />
    </Border>
</UserControl>
