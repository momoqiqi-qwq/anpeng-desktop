<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NuGetAudit>false</NuGetAudit>
    <AppSource>$(MSBuildThisFileDirectory)..\..\source\desktop</AppSource>
    <AppOutput>$(AppSource)\bin\Release\net10.0-windows10.0.26100.0\win-x64</AppOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AppSource)\Models\*.cs" Link="Application\Models\%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)\Data\*.cs" Link="Application\Data\%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)\Services\ReportService.cs" Link="Application\Services\ReportService.cs" />
    <Compile Include="$(AppSource)\Services\MonitoringService.cs" Link="Application\Services\MonitoringService.cs" />
    <Compile Include="$(AppSource)\Services\AlarmEvaluator.cs" Link="Application\Services\AlarmEvaluator.cs" />
    <Compile Include="$(AppSource)\Services\AlarmBeeper.cs" Link="Application\Services\AlarmBeeper.cs" />
    <Compile Include="$(AppSource)\Services\AppLog.cs" Link="Application\Services\AppLog.cs" />
    <Compile Include="$(AppSource)\Services\DeviceClock.cs" Link="Application\Services\DeviceClock.cs" />
    <Compile Include="$(AppSource)\Services\SelfTest.cs" Link="Application\Services\SelfTest.cs" />
    <Compile Include="$(AppSource)\Services\ParityCases.cs" Link="Application\Services\ParityCases.cs" />
    <Compile Include="$(AppSource)\Services\BuildInfo.cs" Link="Application\Services\BuildInfo.cs" />
    <Reference Include="Microsoft.Windows.SDK.NET" HintPath="$(AppOutput)\Microsoft.Windows.SDK.NET.dll" />
    <Reference Include="WinRT.Runtime" HintPath="$(AppOutput)\WinRT.Runtime.dll" />
  </ItemGroup>
</Project>
